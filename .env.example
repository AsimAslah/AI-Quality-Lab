APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_quality_lab.db
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional model-assisted evaluation (disabled when blank)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_MAX_ATTEMPTS=2
ALLOW_EXTERNAL_AI_WITH_PII=false

# Development-only controlled recovery demos
ENABLE_FAILURE_TESTING=false
