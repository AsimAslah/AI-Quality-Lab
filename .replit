entrypoint = "app/main.py"
onBoot = "python -m pip install -r requirements.txt && npm ci"
run = "npm run build && python -m uvicorn app.main:app --host 0.0.0.0 --port 5000 --reload"

[deployment]
build = "npm ci && npm run build"
run = "python -m uvicorn app.main:app --host 0.0.0.0 --port 5000"
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80
